    "method": "DELETE",
    "pathTemplate": "/alerts/rules/{ruleId}"
  },
  "fields": [
    {
      "jsonPath": "alertGroupType",
      "attribute": "alert_group_type",
      "kind": "string",
      "computedOptionalRequired": "optional",
      "writable": true,
      "allowedValues": [
        "bgp",
        "browser-session",
        "cloud-enterprise",
        "endpoint"
      ],
      "behaviour": {
        "zeroValueUnsendable": true
      }
    },
    {
      "jsonPath": "alertType",
      "attribute": "alert_type",
      "kind": "string",
      "computedOptionalRequired": "required",
      "writable": true,
      "allowedValues": [
        "page-load",
        "http-server",
        "end-to-end-server",
        "end-to-end-agent",
        "voice",
        "dns-server",
        "dns-trace",
        "dnssec",
        "bgp",
        "path-trace",
        "ftp",
        "sip-server",
        "transactions",
        "web-transactions",
        "agent",
        "network-outage",
        "application-outage",
        "device-device",
        "device-interface",
        "endpoint-network-server",
        "endpoint-http-server",
        "endpoint-path-trace",
        "endpoint-browser-sessions-agent",
        "endpoint-browser-sessions-application",
        "api",
        "web-transaction",
        "unknown"
      ]
    },
    {
      "jsonPath": "description",
      "attribute": "description",
      "kind": "string",
      "computedOptionalRequired": "optional",
      "writable": true
    },
    {
      "jsonPath": "direction",
      "attribute": "direction",
      "kind": "string",
      "computedOptionalRequired": "optional",
      "writable": true,
      "allowedValues": [
        "to-target",
        "from-target",
        "bidirectional"
      ],
      "behaviour": {
        "zeroValueUnsendable": true
      }
    },
    {
      "jsonPath": "endpointAgentIds",
      "attribute": "endpoint_agent_ids",
      "kind": "set",
      "computedOptionalRequired": "optional",
      "writable": true
    },
    {
      "jsonPath": "endpointLabelIds",
      "attribute": "endpoint_label_ids",
      "kind": "set",
      "computedOptionalRequired": "optional",
      "writable": true
    },
    {
      "jsonPath": "expression",
      "attribute": "expression",
      "kind": "string",
      "computedOptionalRequired": "required",
      "writable": true
    },
    {
      "jsonPath": "includeCoveredPrefixes",
      "attribute": "include_covered_prefixes",
      "kind": "bool",
      "computedOptionalRequired": "optional",
      "writable": true
    },
    {
      "jsonPath": "isDefault",
      "attribute": "is_default",
      "kind": "bool",
      "computedOptionalRequired": "optional",
      "writable": true
    },
    {
      "jsonPath": "minimumSources",
      "attribute": "minimum_sources",
      "kind": "int64",
      "computedOptionalRequired": "optional",
      "writable": true
    },
    {
      "jsonPath": "minimumSourcesPct",
      "attribute": "minimum_sources_pct",
      "kind": "int64",
      "computedOptionalRequired": "optional",
      "writable": true
    },
    {
      "jsonPath": "notifyOnClear",
      "attribute": "notify_on_clear",
      "kind": "bool",
      "computedOptionalRequired": "optional",
      "writable": true
    },
    {
      "jsonPath": "roundsViolatingMode",
      "attribute": "rounds_violating_mode",
      "kind": "string",
      "computedOptionalRequired": "computed",
      "writable": false,
      "allowedValues": [
        "exact",
        "any",
        "auto"
      ]
    },
    {
      "jsonPath": "roundsViolatingOutOf",
      "attribute": "rounds_violating_out_of",
      "kind": "int64",
      "computedOptionalRequired": "required",
      "writable": true
    },
    {
      "jsonPath": "roundsViolatingRequired",
      "attribute": "rounds_violating_required",
      "kind": "int64",
      "computedOptionalRequired": "optional",
      "writable": true
    },
    {
      "jsonPath": "ruleId",
      "attribute": "id",
      "kind": "string",
      "computedOptionalRequired": "computed",
      "writable": false
    },
    {
      "jsonPath": "ruleName",
      "attribute": "rule_name",
      "kind": "string",
      "computedOptionalRequired": "required",
      "writable": true
    },
    {
      "jsonPath": "sensitivityLevel",
      "attribute": "sensitivity_level",
      "kind": "string",
      "computedOptionalRequired": "computed",
      "writable": false,
      "allowedValues": [
        "high",
        "medium",
        "low"
      ]
    },
    {
      "jsonPath": "severity",
      "attribute": "severity",
      "kind": "string",
      "computedOptionalRequired": "optional",
      "writable": true,
      "allowedValues": [
        "info",
        "major",
        "minor",
        "critical",
        "unknown"
      ],
      "behaviour": {
        "zeroValueUnsendable": true
      }
    },
    {
      "jsonPath": "testIds",
      "attribute": "test_ids",
      "kind": "set",
      "computedOptionalRequired": "computed",
      "writable": false
