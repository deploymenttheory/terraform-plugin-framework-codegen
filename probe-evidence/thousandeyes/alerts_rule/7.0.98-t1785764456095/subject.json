{
  "resource": "alerts_rule",
  "collectionTemplate": "/alerts/rules",
  "itemTemplate": "/alerts/rules/{ruleId}",
  "create": {
    "method": "POST",
    "pathTemplate": "/alerts/rules"
  },
  "read": {
    "method": "GET",
    "pathTemplate": "/alerts/rules/{ruleId}"
  },
  "update": {
    "method": "PUT",
    "pathTemplate": "/alerts/rules/{ruleId}"
  },
