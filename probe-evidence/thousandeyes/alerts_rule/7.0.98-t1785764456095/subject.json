    {
      "jsonPath": "visitedSitesFilter",
      "attribute": "visited_sites_filter",
      "kind": "set",
      "computedOptionalRequired": "optional",
      "writable": true
    }
  ],
  "policy": {
    "updateStyle": "putFull",
    "delete": {
      "notFoundIsSuccess": true
    }
  },
  "idField": "ruleId",
  "nameField": "ruleName",
  "evidenceRev": 1
}
