{
  "resource": "tests_ftp_server",
  "collectionTemplate": "/tests/ftp-server",
  "itemTemplate": "/tests/ftp-server/{testId}",
  "create": {
    "method": "POST",
    "pathTemplate": "/tests/ftp-server"
  },
  "read": {
    "method": "GET",
    "pathTemplate": "/tests/ftp-server/{testId}"
  },
  "update": {
    "method": "PUT",
    "pathTemplate": "/tests/ftp-server/{testId}"
  },
  "delete": {
    "method": "DELETE",
    "pathTemplate": "/tests/ftp-server/{testId}"
  },
  "fields": [
    {
      "jsonPath": "agents",
      "attribute": "agents",
      "kind": "set_nested",
      "computedOptionalRequired": "required",
      "writable": true,
      "behaviour": {
        "requiredByApi": true
      }
    },
    {
      "jsonPath": "agents.agentId",
      "attribute": "agent_id",
      "kind": "string",
      "computedOptionalRequired": "required",
      "writable": true
    },
    {
      "jsonPath": "alertsEnabled",
      "attribute": "alerts_enabled",
      "kind": "bool",
      "computedOptionalRequired": "computed_optional",
      "writable": true,
      "behaviour": {
        "serverDefault": {
          "kind": "",
          "raw": "true"
        }
      }
    },
    {
      "jsonPath": "bandwidthMeasurements",
      "attribute": "bandwidth_measurements",
      "kind": "bool",
      "computedOptionalRequired": "computed_optional",
      "writable": true,
      "behaviour": {
        "serverDefault": {
          "kind": "",
          "raw": "false"
        },
        "zeroValueUnsendable": true
      }
    },
    {
      "jsonPath": "bgpMeasurements",
      "attribute": "bgp_measurements",
      "kind": "bool",
      "computedOptionalRequired": "computed_optional",
      "writable": true,
      "behaviour": {
        "serverDefault": {
          "kind": "",
          "raw": "true"
        },
        "zeroValueUnsendable": true
      }
    },
    {
      "jsonPath": "createdBy",
      "attribute": "created_by",
      "kind": "string",
      "computedOptionalRequired": "computed",
      "writable": false
    },
    {
      "jsonPath": "createdDate",
      "attribute": "created_date",
      "kind": "string",
      "computedOptionalRequired": "computed",
      "writable": false
    },
    {
