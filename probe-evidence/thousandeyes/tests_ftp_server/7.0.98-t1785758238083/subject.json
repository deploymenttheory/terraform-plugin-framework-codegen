      "attribute": "enabled",
      "kind": "bool",
      "computedOptionalRequired": "computed_optional",
      "writable": true,
      "behaviour": {
        "serverDefault": {
          "kind": "",
          "raw": "true"
        },
        "zeroValueUnsendable": true
      }
    },
    {
      "jsonPath": "fixedPacketRate",
      "attribute": "fixed_packet_rate",
      "kind": "int64",
      "computedOptionalRequired": "optional",
      "writable": true,
      "constraints": {
        "minimum": 0,
        "maximum": 100
      },
      "behaviour": {
        "zeroValueUnsendable": true
      }
    },
    {
      "jsonPath": "ftpTargetTime",
      "attribute": "ftp_target_time",
      "kind": "int64",
      "computedOptionalRequired": "computed_optional",
      "writable": true,
      "constraints": {
        "minimum": 1000,
        "maximum": 6000
      },
      "behaviour": {
        "serverDefault": {
          "kind": "",
          "raw": "1000"
        }
      }
    },
    {
      "jsonPath": "ftpTimeLimit",
      "attribute": "ftp_time_limit",
      "kind": "int64",
      "computedOptionalRequired": "computed_optional",
      "writable": true,
      "constraints": {
        "minimum": 10,
        "maximum": 60
      },
      "behaviour": {
        "serverDefault": {
          "kind": "",
          "raw": "5"
        }
      }
    },
    {
      "jsonPath": "interval",
      "attribute": "interval",
      "kind": "int64",
      "computedOptionalRequired": "optional",
      "writable": true,
      "allowedValues": [
        "60",
        "120",
        "300",
        "600",
        "900",
        "1800",
        "3600"
      ],
      "behaviour": {
        "requiredByApi": true
      }
    },
    {
      "jsonPath": "ipv6Policy",
      "attribute": "ipv6_policy",
      "kind": "string",
      "computedOptionalRequired": "computed_optional",
      "writable": true,
      "allowedValues": [
        "force-ipv4",
        "prefer-ipv6",
        "force-ipv6",
        "use-agent-policy"
