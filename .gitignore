# macOS
.DS_Store

# VSCode
.vs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Build and temp files
/build/
/tmp/
*.log
*.bak

# Windows-specific 
*.winfile eol=crlf

# Go development
*.test
/vendor/
/bin/
/dist/
/pkg/
coverage.out
coverage.html
golangci-lint-report.sarif

# Go workspaces are deliberately not committed: they break dependabot's
# per-directory module resolution and golangci-lint's new-from-merge-base.
# CI enters the nested pilot module explicitly instead.
go.work
go.work.sum

# tfpluginframeworkgen
/bin/tfpluginframeworkgen
.tfpluginframeworkgen/cache/

# Emitted when a template renders unparseable Go, kept for inspection only.
*.broken

# Python virtual environments
scripts/python/venv/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
*.egg-info/

# AI instructions
.claude
.cursor

# Binaries and executables
*.dll
*.exe
*.dylib
*.so