# macOS
.DS_Store

# VSCode
.vs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Build and temp files
/build/
/tmp/
*.log
*.bak

# Windows-specific 
*.winfile eol=crlf

# Go development
*.test
/vendor/
/bin/
/dist/
/pkg/
coverage.out
coverage.html
golangci-lint-report.sarif

# Go workspaces are deliberately not committed: they break dependabot's
# per-directory module resolution and golangci-lint's new-from-merge-base.
# CI enters the nested pilot module explicitly instead.
go.work
go.work.sum

# tfpfgen
/bin/tfpfgen
.tfpfgen/cache/

# The corpus cache belongs in the user cache directory and the code puts it
# there. This is the backstop for the mistake that pattern above does not catch:
# a path relative to the working directory, which `go test` sets per package, so
# caches appear inside package directories where a root-anchored pattern never
# matches. It once put 19 MB of fetched specifications into a commit.
**/.tfpfgen/cache/

# A probe ledger records live objects in somebody's tenant. It is per-run rather than
# per-snapshot, so committing one would be both meaningless and a disclosure.
.tfpfgen/probe/

# A sandbox profile carries assertions.accountGroupId, and a tenant identifier in a committed
# file turns a vulnerability into a targeted one. See docs/examples/probe-profile.example.json
# for a version with nothing real in it.
.tfpfgen/sandbox/

.tfpluginframeworkgen/

# Emitted when a template renders unparsable Go, kept for inspection only.
*.broken

# Python virtual environments
scripts/python/venv/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
*.egg-info/

# AI instructions
.claude
.cursor

# Binaries and executables
*.dll
*.exe
*.dylib
*.sodist/

