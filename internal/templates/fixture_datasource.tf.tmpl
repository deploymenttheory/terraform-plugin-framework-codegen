{{ .Header }}

# The seed resource this data source reads back, then the data block itself. One file,
# because the reference below only resolves against the resource above it.

{{- range .Seed.DataBlocks }}
{{ . }}
{{ end }}
resource "{{ .Seed.TerraformType }}" "{{ .Seed.Label }}" {
{{- range .Seed.Values }}
  {{ .Name }}{{ .Padding }} = {{ .HCL }}
{{- end }}
}

data "{{ .TerraformType }}" "{{ .Label }}" {
{{- range .Args }}
  {{ .Name }}{{ .Padding }} = {{ .HCL }}
{{- end }}
}
