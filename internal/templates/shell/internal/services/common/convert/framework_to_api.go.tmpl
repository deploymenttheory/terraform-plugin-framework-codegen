package convert

import (
	"context"
	"fmt"
	"time"

	"github.com/hashicorp/terraform-plugin-framework/types"
)

// FrameworkToAPIString hands the plain string to the setter unless the
// value is null or unknown.
func FrameworkToAPIString(value types.String, setter func(*string)) {
	if value.IsNull() || value.IsUnknown() {
		return
	}
	v := value.ValueString()
	setter(&v)
}

// FrameworkToAPIBool hands the plain bool to the setter unless the value
// is null or unknown.
func FrameworkToAPIBool(value types.Bool, setter func(*bool)) {
	if value.IsNull() || value.IsUnknown() {
		return
	}
