func FrameworkToAPIFloat64AsFloat32(value types.Float64, setter func(*float32)) {
	if value.IsNull() || value.IsUnknown() {
		return
	}
	narrowed := float32(value.ValueFloat64())
	setter(&narrowed)
}

// FrameworkToAPITime parses the RFC 3339 string and hands the time to the
// setter, erroring on a malformed value.
func FrameworkToAPITime(value types.String, setter func(*time.Time)) error {
	if value.IsNull() || value.IsUnknown() {
		return nil
	}
	parsed, err := time.Parse(time.RFC3339, value.ValueString())
	if err != nil {
		return fmt.Errorf("%q is not an RFC 3339 timestamp: %w", value.ValueString(), err)
	}
	setter(&parsed)
	return nil
}

// FrameworkToAPIStringList hands the plain []string to the setter unless
// the list is null or unknown.
func FrameworkToAPIStringList(ctx context.Context, value types.List, setter func([]string)) error {
	if value.IsNull() || value.IsUnknown() {
		return nil
	}
	var values []string
	if diags := value.ElementsAs(ctx, &values, false); diags.HasError() {
		return fmt.Errorf("reading a string list from the plan: %v", diags.Errors())
	}
	setter(values)
	return nil
}
