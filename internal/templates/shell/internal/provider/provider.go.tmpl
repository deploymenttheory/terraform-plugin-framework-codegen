// Package provider is the provider server.
//
// The schema and configuration plumbing here are generated from the provider
// blueprint by `tfpfgen provider scaffold`; a change to how the provider
// authenticates belongs in the generator's shell templates, not in an edit here.
// The resource and data source registration lists are generated separately: see
// resources.go and datasources.go, which `provider generate` rewrites on every run.
package provider

import (
	"context"
	"os"

	"github.com/hashicorp/terraform-plugin-framework/path"
	"github.com/hashicorp/terraform-plugin-framework/provider"
	"github.com/hashicorp/terraform-plugin-framework/provider/schema"
	"github.com/hashicorp/terraform-plugin-framework/types"
	"github.com/hashicorp/terraform-plugin-log/tflog"

	teclient "{{ .Module }}/internal/client"
)

// Environment variables the provider falls back to, matching the SDK's own
// names so a practitioner does not have to learn two sets.
const (
{{- if .IsBearer }}
	envBearerToken = "{{ .EnvPrefix }}_BEARER_TOKEN"
{{- end }}
{{- if .IsClientCredentials }}
	envClientID     = "{{ .EnvPrefix }}_CLIENT_ID"
	envClientSecret = "{{ .EnvPrefix }}_CLIENT_SECRET"
{{- end }}
{{- if .IsUsernamePassword }}
	envUsername = "{{ .EnvPrefix }}_USERNAME"
	envPassword = "{{ .EnvPrefix }}_PASSWORD"
{{- end }}
	envAccountGroupID = "{{ .EnvPrefix }}_ACCOUNT_GROUP_ID"
	envAPIEndpoint    = "{{ .EnvPrefix }}_API_ENDPOINT"
)

var _ provider.Provider = (*Provider)(nil)

// Provider is the {{ .DisplayName }} provider.
type Provider struct {
	// version is set at build time and reported to Terraform.
	version string
	// client, when non-nil, is used instead of building one from configuration.
	// Unit tests set it so they can run against an interception layer without
	// credentials.
	client any
}

// New returns a provider factory for the given version.
func New(version string) func() provider.Provider {
	return func() provider.Provider {
		return &Provider{version: version}
	}
}

// NewWithClient returns a provider that uses a pre-built client. It exists for
// unit tests, which must never depend on credentials being present.
func NewWithClient(version string, client any) func() provider.Provider {
	return func() provider.Provider {
		return &Provider{version: version, client: client}
	}
}

func (p *Provider) Metadata(_ context.Context, _ provider.MetadataRequest, resp *provider.MetadataResponse) {
	resp.TypeName = "{{ .Name }}"
	resp.Version = p.version
}

// Model is the provider block's configuration.
type Model struct {
{{- if .IsBearer }}
	BearerToken types.String `tfsdk:"bearer_token"`
{{- end }}
{{- if .IsClientCredentials }}
	ClientID     types.String `tfsdk:"client_id"`
	ClientSecret types.String `tfsdk:"client_secret"`
{{- end }}
{{- if .IsUsernamePassword }}
	Username types.String `tfsdk:"username"`
	Password types.String `tfsdk:"password"`
{{- end }}
	AccountGroupID types.String `tfsdk:"account_group_id"`
	APIEndpoint    types.String `tfsdk:"api_endpoint"`
}

func (p *Provider) Schema(_ context.Context, _ provider.SchemaRequest, resp *provider.SchemaResponse) {
	resp.Schema = schema.Schema{
		MarkdownDescription: "Manages {{ .DisplayName }} resources.",
		Attributes: map[string]schema.Attribute{
{{- if .IsBearer }}
			"bearer_token": schema.StringAttribute{
				MarkdownDescription: "A bearer token for the {{ .DisplayName }} API, sent as " +
					"`Authorization: Bearer`. May also be set with the `" + envBearerToken +
					"` environment variable.\n\n" +
					"How the token is issued and revoked is the API's own business: see the " +
					"{{ .DisplayName }} documentation. The provider never logs it.",
				Optional:  true,
				Sensitive: true,
			},
{{- end }}
{{- if .IsClientCredentials }}
			"client_id": schema.StringAttribute{
				MarkdownDescription: "The OAuth 2.0 client identifier the provider presents to the " +
					"{{ .DisplayName }} token endpoint. May also be set with the `" + envClientID +
					"` environment variable.",
				Optional: true,
			},
			"client_secret": schema.StringAttribute{
				MarkdownDescription: "The secret paired with `client_id`. May also be set with the `" +
					envClientSecret + "` environment variable.\n\n" +
					"The provider runs the client-credentials grant itself and holds the resulting " +
					"access token in memory only, so no token is ever written to configuration or " +
					"to state.",
				Optional:  true,
				Sensitive: true,
			},
{{- end }}
{{- if .IsUsernamePassword }}
			"username": schema.StringAttribute{
				MarkdownDescription: "The user the provider authenticates to the {{ .DisplayName }} " +
					"API as, sent as HTTP Basic credentials. May also be set with the `" + envUsername +
					"` environment variable.",
				Optional: true,
			},
			"password": schema.StringAttribute{
				MarkdownDescription: "The password for `username`. May also be set with the `" +
					envPassword + "` environment variable.\n\n" +
					"HTTP Basic sends the password itself on every request, base64-encoded rather " +
					"than encrypted, so the API endpoint must be HTTPS.",
				Optional:  true,
				Sensitive: true,
			},
{{- end }}
			"account_group_id": schema.StringAttribute{
				MarkdownDescription: "Scopes every request to an account group, sent as the `aid` " +
					"query parameter. When unset, the API uses the token owner's default account " +
					"group, which means an object can appear absent rather than merely invisible. " +
					"May also be set with the `" + envAccountGroupID + "` environment variable.",
				Optional: true,
			},
			"api_endpoint": schema.StringAttribute{
				MarkdownDescription: "Overrides the API base URL. Defaults to the endpoint the SDK " +
					"was generated against. May also be set with the `" + envAPIEndpoint +
					"` environment variable.",
				Optional: true,
			},
		},
	}
}

func (p *Provider) Configure(ctx context.Context, req provider.ConfigureRequest, resp *provider.ConfigureResponse) {
	// A test-supplied client short-circuits configuration entirely, so unit
	// tests need no credentials and cannot reach the network by accident.
	if p.client != nil {
		configureAllKinds(resp, p.client)
		return
	}

	var cfg Model
	resp.Diagnostics.Append(req.Config.Get(ctx, &cfg)...)
	if resp.Diagnostics.HasError() {
		return
	}

	resolved := teclient.Config{
{{- if .IsBearer }}
		BearerToken: firstNonEmpty(cfg.BearerToken, envBearerToken),
{{- end }}
{{- if .IsClientCredentials }}
		ClientID:     firstNonEmpty(cfg.ClientID, envClientID),
		ClientSecret: firstNonEmpty(cfg.ClientSecret, envClientSecret),
{{- end }}
{{- if .IsUsernamePassword }}
		Username: firstNonEmpty(cfg.Username, envUsername),
		Password: firstNonEmpty(cfg.Password, envPassword),
{{- end }}
		AccountGroupID: firstNonEmpty(cfg.AccountGroupID, envAccountGroupID),
		APIEndpoint:    firstNonEmpty(cfg.APIEndpoint, envAPIEndpoint),
	}

	// Missing credentials are refused here rather than at the first request,
	// because a diagnostic naming the attribute is the only thing that tells a
	// practitioner which of the two halves they left out.
{{- if .IsBearer }}
	if resolved.BearerToken == "" {
		resp.Diagnostics.AddAttributeError(
			path.Root("bearer_token"),
			"Missing {{ .DisplayName }} bearer token",
			"Set the bearer_token provider attribute or the "+envBearerToken+" environment variable.",
		)
		return
	}
{{- end }}
{{- if .IsClientCredentials }}
	if resolved.ClientID == "" {
		resp.Diagnostics.AddAttributeError(
			path.Root("client_id"),
			"Missing {{ .DisplayName }} client id",
			"Set the client_id provider attribute or the "+envClientID+" environment variable.",
		)
	}
	if resolved.ClientSecret == "" {
		resp.Diagnostics.AddAttributeError(
			path.Root("client_secret"),
			"Missing {{ .DisplayName }} client secret",
			"Set the client_secret provider attribute or the "+envClientSecret+" environment variable.",
		)
	}
	if resp.Diagnostics.HasError() {
		return
	}
{{- end }}
{{- if .IsUsernamePassword }}
	if resolved.Username == "" {
		resp.Diagnostics.AddAttributeError(
			path.Root("username"),
			"Missing {{ .DisplayName }} username",
			"Set the username provider attribute or the "+envUsername+" environment variable.",
		)
	}
	if resolved.Password == "" {
		resp.Diagnostics.AddAttributeError(
			path.Root("password"),
			"Missing {{ .DisplayName }} password",
			"Set the password provider attribute or the "+envPassword+" environment variable.",
		)
	}
	if resp.Diagnostics.HasError() {
		return
	}
{{- end }}

	client, err := teclient.New(resolved)
	if err != nil {
		resp.Diagnostics.AddError("Unable to configure the {{ .DisplayName }} client", err.Error())
		return
	}

	tflog.Debug(ctx, "configured the {{ .DisplayName }} client", map[string]any{
		"account_group_id_set": resolved.AccountGroupID != "",
		"custom_endpoint":      resolved.APIEndpoint != "",
	})

	configureAllKinds(resp, client)
}

// configureAllKinds hands the client to every block kind the provider serves.
//
// The framework carries one field per kind, and setting only some of them is the bug the
// first live acceptance run found: actions, ephemerals and list resources received a nil
// client and crashed on first use. One function, so a kind added later is added here or
// visibly nowhere.
func configureAllKinds(resp *provider.ConfigureResponse, client any) {
	resp.ResourceData = client
	resp.DataSourceData = client
	resp.ActionData = client
	resp.EphemeralResourceData = client
	resp.ListResourceData = client
}

// firstNonEmpty prefers the configured value, then the environment variable.
// Configuration winning over the environment is the convention practitioners
// expect: an explicit value in a file should not be silently overridden by a
// stray shell export.
func firstNonEmpty(configured types.String, envVar string) string {
	if !configured.IsNull() && !configured.IsUnknown() && configured.ValueString() != "" {
		return configured.ValueString()
	}
	return os.Getenv(envVar)
}

// Resources and DataSources are implemented in the generated resources.go and
// datasources.go, so adding a resource is a regeneration rather than an edit here.
