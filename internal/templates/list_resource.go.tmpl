// no filter arguments on its collection read -- so a query lists everything visible to the
// configured credentials.
func (l *{{ .List.GoTypeName }}) ListResourceConfigSchema(_ context.Context, _ list.ListResourceSchemaRequest, resp *list.ListResourceSchemaResponse) {
