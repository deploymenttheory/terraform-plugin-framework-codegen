// Command terraform-provider-{{ .ProviderName }} serves the {{ .ProviderName }} provider.
//
// Every file in this repository is generated by tfpfgen; change the revised
// spec or tfpfgen.yaml and regenerate rather than editing here.
package main

import (
	"context"
	"flag"
	"log"

	"github.com/hashicorp/terraform-plugin-framework/providerserver"

	"{{ .Module }}/internal/provider"
)

// version is stamped at release time via -ldflags "-X main.version=...".
// A source build reports "dev".
var version = "dev"

func main() {
	var debug bool

	flag.BoolVar(&debug, "debug", false, "run with support for debuggers such as delve")
	flag.Parse()

	err := providerserver.Serve(context.Background(), provider.New(version), providerserver.ServeOpts{
		Address: "{{ .RegistryAddress }}",
		Debug:   debug,
	})
	if err != nil {
		log.Fatal(err)
	}
}
