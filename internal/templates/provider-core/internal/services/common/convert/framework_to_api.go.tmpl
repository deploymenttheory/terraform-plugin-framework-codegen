	v := value.ValueInt64()
	setter(&v)
}

// FrameworkToAPIInt64AsInt32 narrows the plan's int64 to the SDK's int32,
// erroring on a value the wire type cannot carry.
func FrameworkToAPIInt64AsInt32(value types.Int64, setter func(*int32)) error {
	if value.IsNull() || value.IsUnknown() {
		return nil
	}
	v := value.ValueInt64()
	if v > 2147483647 || v < -2147483648 {
		return fmt.Errorf("%d does not fit the API's 32-bit integer", v)
	}
	narrowed := int32(v)
	setter(&narrowed)
	return nil
}

