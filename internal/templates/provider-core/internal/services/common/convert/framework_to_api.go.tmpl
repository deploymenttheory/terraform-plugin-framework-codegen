// FrameworkToAPIInt64ListAsInt32 narrows the plan's int64 list to the
// SDK's []int32, erroring on any element the wire type cannot carry.
func FrameworkToAPIInt64ListAsInt32(ctx context.Context, value types.List, setter func([]int32)) error {
	if value.IsNull() || value.IsUnknown() {
		return nil
	}
	var values []int64
	if diags := value.ElementsAs(ctx, &values, false); diags.HasError() {
		return fmt.Errorf("reading an int64 list from the plan: %v", diags.Errors())
	}
	narrowed := make([]int32, len(values))
	for i, v := range values {
		if v > 2147483647 || v < -2147483648 {
			return fmt.Errorf("%d does not fit the API's 32-bit integer", v)
		}
		narrowed[i] = int32(v)
	}
	setter(narrowed)
	return nil
}

