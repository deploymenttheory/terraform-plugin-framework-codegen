// APIToFrameworkStringValue converts a plain string to types.String. The
// Value converters exist for SDKs whose accessors return values rather
// than pointers; an absent field arrives as the zero value there, and the
// zero value is what the state carries.
func APIToFrameworkStringValue(value string) types.String {
	return types.StringValue(value)
}

