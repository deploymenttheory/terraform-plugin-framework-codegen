package convert

import (
	"context"
	"fmt"

	"github.com/google/uuid"
	"github.com/hashicorp/terraform-plugin-framework/attr"
	"github.com/hashicorp/terraform-plugin-framework/types"
	"github.com/microsoft/kiota-abstractions-go/serialization"
)

// APIToFrameworkEnum converts a kiota enum — any fmt.Stringer — to
// types.String, nil to null.
func APIToFrameworkEnum[T fmt.Stringer](value *T) types.String {
	if value == nil {
		return types.StringNull()
	}
	return types.StringValue((*value).String())
}

// FrameworkToAPIEnum parses the plan's string with the kiota-generated
// Parse function and hands the typed enum to the setter, erroring on a
// value the enum does not declare:
//
//	err := convert.FrameworkToAPIEnum(plan.Status, sdk.ParseStatus, body.SetStatus)
func FrameworkToAPIEnum[T any](value types.String, parser func(string) (any, error), setter func(*T)) error {
	if value.IsNull() || value.IsUnknown() {
		return nil
	}
	parsed, err := parser(value.ValueString())
	if err != nil {
		return fmt.Errorf("%q is not a declared enum value: %w", value.ValueString(), err)
	}
	typed, ok := parsed.(*T)
	if !ok {
		return fmt.Errorf("the parsed enum is %T, not %T", parsed, (*T)(nil))
	}
	setter(typed)
	return nil
}

// APIToFrameworkDateOnly converts kiota's DateOnly to types.String, nil
// to null.
func APIToFrameworkDateOnly(value *serialization.DateOnly) types.String {
	if value == nil {
		return types.StringNull()
	}
	return types.StringValue(value.String())
}

// FrameworkToAPIDateOnly parses the plan's date string and hands kiota's
// DateOnly to the setter, erroring on a malformed value.
func FrameworkToAPIDateOnly(value types.String, setter func(*serialization.DateOnly)) error {
	if value.IsNull() || value.IsUnknown() {
		return nil
	}
	parsed, err := serialization.ParseDateOnly(value.ValueString())
	if err != nil {
		return fmt.Errorf("%q is not a date: %w", value.ValueString(), err)
	}
	setter(parsed)
	return nil
}

// APIToFrameworkUUID converts *uuid.UUID to types.String, nil to null.
func APIToFrameworkUUID(value *uuid.UUID) types.String {
	if value == nil {
		return types.StringNull()
	}
	return types.StringValue(value.String())
}

// FrameworkToAPIUUID parses the plan's string and hands the uuid to the
// setter, erroring on a value that is not one.
func FrameworkToAPIUUID(value types.String, setter func(*uuid.UUID)) error {
	if value.IsNull() || value.IsUnknown() {
		return nil
	}
	parsed, err := uuid.Parse(value.ValueString())
	if err != nil {
		return fmt.Errorf("%q is not a uuid: %w", value.ValueString(), err)
	}
	setter(&parsed)
	return nil
}

// APIToFrameworkUUIDList converts []uuid.UUID to a types.List of their
// string spellings, nil to null.
func APIToFrameworkUUIDList(values []uuid.UUID) types.List {
	if values == nil {
		return types.ListNull(types.StringType)
	}
	elements := make([]attr.Value, len(values))
	for i, v := range values {
		elements[i] = types.StringValue(v.String())
	}
	return types.ListValueMust(types.StringType, elements)
}

// FrameworkToAPIUUIDList parses each element of the plan's string list and
// hands the []uuid.UUID to the setter, erroring on the first element that
// is not a uuid.
func FrameworkToAPIUUIDList(ctx context.Context, value types.List, setter func([]uuid.UUID)) error {
	if value.IsNull() || value.IsUnknown() {
		return nil
	}
	var raw []string
	if diags := value.ElementsAs(ctx, &raw, false); diags.HasError() {
		return fmt.Errorf("reading a string list from the plan: %v", diags.Errors())
	}
	parsed := make([]uuid.UUID, 0, len(raw))
	for _, element := range raw {
		one, err := uuid.Parse(element)
		if err != nil {
			return fmt.Errorf("%q is not a uuid: %w", element, err)
		}
		parsed = append(parsed, one)
	}
	setter(parsed)
	return nil
}

// APIToFrameworkEnumValue converts a value-typed kiota enum to
// types.String.
func APIToFrameworkEnumValue[T fmt.Stringer](value T) types.String {
	return types.StringValue(value.String())
}

// APIToFrameworkEnumSlice converts a slice of kiota enums to a
// types.List of their string spellings, nil to null.
func APIToFrameworkEnumSlice[T fmt.Stringer](values []T) types.List {
	if values == nil {
		return types.ListNull(types.StringType)
	}
	elements := make([]attr.Value, len(values))
	for i, v := range values {
		elements[i] = types.StringValue(v.String())
	}
	return types.ListValueMust(types.StringType, elements)
}

// FrameworkToAPIEnumSlice parses each element of the plan's string list
// with the kiota-generated Parse function and hands the typed slice to
// the setter, erroring on any value the enum does not declare.
func FrameworkToAPIEnumSlice[T any](ctx context.Context, value types.List, parser func(string) (any, error), setter func([]T)) error {
	if value.IsNull() || value.IsUnknown() {
		return nil
	}
	var raw []string
	if diags := value.ElementsAs(ctx, &raw, false); diags.HasError() {
		return fmt.Errorf("reading a string list from the plan: %v", diags.Errors())
	}
	typed := make([]T, 0, len(raw))
	for _, element := range raw {
		parsed, err := parser(element)
		if err != nil {
			return fmt.Errorf("%q is not a declared enum value: %w", element, err)
		}
		pointer, ok := parsed.(*T)
		if !ok {
			return fmt.Errorf("the parsed enum is %T, not %T", parsed, (*T)(nil))
		}
		typed = append(typed, *pointer)
	}
	setter(typed)
	return nil
}
