// The data source under test, and the seed resource whose apply produced the object it
// reads. The only thing this test creates is the seed, so existence and destroy are
// verified through the seed's own helper.
const (
	address     = "{{ .Address }}"
	seedAddress = "{{ .SeedAddress }}"
)

var seedResource = {{ .SeedTestResourceType }}{}

// {{ .TestName }} seeds one object and reads it back through the data source.
//
// Every cross-key check compares the data source's state against the state the seed's
// apply produced. That is the point of the test: the two arrive by different code paths
// -- the resource's create-then-read against the data source's read -- and a flatten
// that drops or mangles a field on either path shows up here as a mismatch, which no
// amount of compiling can see.
func {{ .TestName }}(t *testing.T) {
{{- if .SkipUnlessEnv }}
	// Gated: the seed or the read needs more privilege than the ordinary credential
	// carries, so a run against a lesser token skips this by name rather than failing red.
	if os.Getenv("{{ .SkipUnlessEnv }}") == "" {
		t.Skipf("set {{ .SkipUnlessEnv }} to run this test; it needs a more privileged credential")
	}
{{- end }}
	resource.Test(t, resource.TestCase{
		PreCheck:                 func() { acceptance.PreCheck(t) },
		ProtoV6ProviderFactories: acceptance.ProtoV6ProviderFactories,
		// hashicorp/time supplies the propagation wait the fixture declares between
		// creating the seed and reading it back.
		ExternalProviders: map[string]resource.ExternalProvider{
			"time": {Source: "hashicorp/time", VersionConstraint: ">= 0.14.0"},
		},
		// The data source owns nothing; destroy verification is the seed's.
		//
{{ .DestroyReason }}
		CheckDestroy: destroy.CheckDestroyed(seedResource, "{{ .SeedTerraformType }}", {{ .DestroyTimeout }}),
		Steps: []resource.TestStep{
			{
				Config: config(t, "datasource.tf"),
				Check: resource.ComposeAggregateTestCheckFunc(
{{- range .Checks }}
					{{ . }},
{{- end }}
				),
			},
		},
	})
}

// config reads the committed fixture; see the resource acceptance test for why testdata.
func config(t *testing.T, name string) string {
	t.Helper()

	body, err := os.ReadFile(filepath.Join("testdata", name))
	if err != nil {
		t.Fatalf("reading fixture %s: %v", name, err)
	}

	return string(body)
}
