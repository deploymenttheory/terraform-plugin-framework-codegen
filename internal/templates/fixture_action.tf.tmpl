{{ .Header }}

# The action under test, invoked once by a terraform_data trigger on create. The
# subject's identifier arrives as a variable, supplied by the generated test from the
# environment -- an action's subject frequently cannot be created by Terraform.
{{- if not .Reversed }}
#
# No cleanup operation is declared, so the action is NOT reversed after the run.
{{- end }}
{{ range .Vars }}
variable "{{ . }}" {
  type = string
}
{{ end }}
action "{{ .ActionType }}" "{{ .Label }}" {
  config {
{{- range .Args }}
    {{ .Name }}{{ .Padding }} = {{ .HCL }}
{{- end }}
  }
}

resource "terraform_data" "trigger" {
  lifecycle {
    action_trigger {
      events  = [after_create]
      actions = [action.{{ .ActionType }}.{{ .Label }}]
    }
  }
}
