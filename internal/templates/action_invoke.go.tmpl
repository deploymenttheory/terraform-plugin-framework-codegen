// Invoke performs the {{ $.ActionName }} operation.
//
// One call, and nothing written back. The SDK's response is deliberately discarded:
// action.InvokeResponse carries diagnostics and a progress channel, and has no field for a
// result -- so an action reports that it happened, not what it returned.
func (a *{{ $.GoTypeName }}) Invoke(ctx context.Context, req action.InvokeRequest, resp *action.InvokeResponse) {
	var data {{ $.ModelTypeName }}

	resp.Diagnostics.Append(req.Config.Get(ctx, &data)...)
	if resp.Diagnostics.HasError() {
		return
	}

	tflog.Debug(ctx, "invoking action", map[string]any{"action": TypeName})

	// A nil client is a provider bug -- Configure must populate ActionData -- and the
	// first live run proved the failure mode is a segfault that kills the whole provider
	// process. A diagnostic names the bug; a crash names nothing.
	if a.client == nil {
		resp.Diagnostics.AddError(
			"Provider not configured",
			"The provider did not hand this action a client. This is a bug in the "+
				"provider; please report it.",
		)

		return
	}

	ctx, cancel := context.WithTimeout(ctx, InvokeTimeout*time.Second)
	defer cancel()

	// Progress is reported before the call rather than after: an action that takes a while
	// otherwise looks hung, and the practitioner has no other signal that it started.
	if resp.SendProgress != nil {
		resp.SendProgress(action.InvokeProgressEvent{
			Message: "calling the API",
		})
	}

	{{ .Assign }} {{ .Call }}
	if err != nil {
		errors.Handle(&resp.Diagnostics, TypeName, {{ .ErrorOp }}, err)

		return
	}

	tflog.Debug(ctx, "action completed", map[string]any{"action": TypeName})
}
{{ end }}
