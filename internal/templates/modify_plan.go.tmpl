// ModifyPlan below is the generated default: no adjustment. The hook exists for
// plan-time judgement no specification carries -- replacement decisions that
// depend on another attribute, diffs the API's own normalisation creates,
// cross-attribute rules configValidators cannot state. Those decisions belong
// in the blueprint, carried as declared facts the emitter renders; an edit made
// here directly is drift the check reports. Removing hooks.modifyPlan removes
// this file, because the generated resource asserts
// resource.ResourceWithModifyPlan while the flag is set.

package {{ .Package }}

import (
	"context"

	"github.com/hashicorp/terraform-plugin-framework/resource"
)

// ModifyPlan adjusts the planned state for a {{ .ResourceName }}.
//
// Called on create, update and destroy. Distinguish them before doing anything: on destroy the
// plan is null, and on create the prior state is.
func (r *{{ .GoTypeName }}) ModifyPlan(ctx context.Context, req resource.ModifyPlanRequest, resp *resource.ModifyPlanResponse) {
	// Destroy: nothing planned, so there is nothing to modify.
	if req.Plan.Raw.IsNull() {
		return
	}

	// Create: no prior state to compare against.
	if req.State.Raw.IsNull() {
		return
	}

	// An update. Read plan and state into {{ .ModelTypeName }} and adjust resp.Plan as needed.
}
