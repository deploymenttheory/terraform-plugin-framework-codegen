{{ .Header }}
{{ if .DocRefComment }}
{{ .DocRefComment }}
{{- end }}
package {{ .Package }}

import (
{{ .Imports.Action }}
)

const (
	// TypeName is the Terraform type this action registers as.
	TypeName = "{{ .ActionName }}"

	// InvokeTimeout is the deadline in seconds. One operation, one deadline -- and unlike a
	// resource there is no timeouts block to override it, because the framework's action
	// schema has no home for one.
	InvokeTimeout = {{ .InvokeTimeout }}
)

{{ if .PatternVars }}
// Patterns the schema's RegexMatches validators check against.
//
// Compiled once at package scope rather than inline in the schema, so the expression sits
// somewhere a reader can find it instead of buried mid-literal.
{{- range .PatternVars }}
{{ . }}
{{- end }}
{{ end }}
// Compile-time assertions that this action implements what it claims to.
var (
{{- range .Interfaces }}
	{{ . }}
{{- end }}
)

// {{ .ConstructorFn }} returns the {{ .ActionName }} action.
func {{ .ConstructorFn }}() action.Action {
	return &{{ .GoTypeName }}{}
}

// {{ .GoTypeName }} implements the {{ .ActionName }} action.
//
// An action has no state. It reads configuration, calls the API once and reports what
// happened, which is why there is no model to reconcile and no flatten step: InvokeRequest
// carries only a config and InvokeResponse has no field to return a value in.
type {{ .GoTypeName }} struct {
	client {{ .SDKClientType }}
}

// Metadata returns the action type name.
func (a *{{ .GoTypeName }}) Metadata(_ context.Context, _ action.MetadataRequest, resp *action.MetadataResponse) {
	resp.TypeName = TypeName
}

// Configure receives the configured SDK client from the provider.
//
// action.ConfigureRequest, which is its own type: the framework gives each block kind a
// distinct one, so this cannot share the resource's helper.
func (a *{{ .GoTypeName }}) Configure(ctx context.Context, req action.ConfigureRequest, resp *action.ConfigureResponse) {
	a.client = client.ForAction(ctx, req, resp, TypeName)
}

// Schema returns the action schema.
//
// Every attribute is required or optional. An action attribute cannot be Computed or
// Sensitive -- there is no state for a computed value to live in, and no stored value to mark
// sensitive -- which blueprint.Validate refuses rather than emitting a field that does not
// exist on the action schema types.
func (a *{{ .GoTypeName }}) Schema(ctx context.Context, _ action.SchemaRequest, resp *action.SchemaResponse) {
	resp.Schema = schema.Schema{
{{- if .MarkdownDescription }}
		MarkdownDescription: {{ printf "%q" .MarkdownDescription }},
{{- end }}
		Attributes: map[string]schema.Attribute{
{{- range .SchemaAttributes }}
			{{ . }},
{{- end }}
		},
	}
}
