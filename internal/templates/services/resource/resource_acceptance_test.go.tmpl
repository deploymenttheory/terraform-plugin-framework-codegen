{{ template "header" . }}

package {{ .Package }}_test

{{ .AccImports }}

//go:embed tests/terraform/acceptance/resource_minimal.tf
var accConfigMinimal string

//go:embed tests/terraform/acceptance/resource_maximal.tf
var accConfigMaximal string

// TestAcc{{ .Pascal }}Resource_Lifecycle drives the full lifecycle against
// the live API. It only runs when TF_ACC is set, and PreCheck names the
// first missing environment variable before anything is created.
func TestAcc{{ .Pascal }}Resource_Lifecycle(t *testing.T) {
	resource.Test(t, resource.TestCase{
		PreCheck:                 func() { acceptance.PreCheck(t) },
		ProtoV6ProviderFactories: acceptance.ProtoV6ProviderFactories,
		// The configuration suffixes its synthesised names with a random
		// string, so a re-run never collides with what the last one left
		// behind. The provider supplying it is external to this one.
		ExternalProviders: map[string]resource.ExternalProvider{
			"random": {Source: "hashicorp/random"},
		},
		Steps: []resource.TestStep{
			{
				Config: accConfigMinimal,
				Check: resource.ComposeTestCheckFunc(
					resource.TestCheckResourceAttrSet("{{ .TerraformType }}.test", "id"),
				),
			},
{{- if .HasImport }}
			{
				ResourceName:            "{{ .TerraformType }}.test",
				ImportState:             true,
				ImportStateVerify:       true,
				ImportStateVerifyIgnore: []string{"timeouts"{{ .ImportStateVerifyIgnore }}},
			},
{{- end }}
			{
				Config: accConfigMaximal,
				Check: resource.ComposeTestCheckFunc(
					resource.TestCheckResourceAttrSet("{{ .TerraformType }}.test", "id"),
				),
			},
		},
	})
}
