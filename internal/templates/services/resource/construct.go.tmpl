{{ template "header" . }}

package {{ .Package }}

{{ .ConstructImports }}

// constructResource builds the request body from the plan. isCreate gates
// the attributes updates silently discard; a null or unknown plan value
// leaves its field unset.
func constructResource(ctx context.Context, data *{{ .Type }}Model, isCreate bool) ({{ .ConstructReturnType }}, error) {
	_ = ctx
	_ = isCreate
	body := {{ .WriteConstructor }}
{{ .ConstructBody }}
	return body, nil
}
{{ if .HasUpdateBody }}
// constructUpdate builds the update request body from the plan. The API
// declares a body for the update that the create's cannot serve, so the two
// are built separately; a null or unknown plan value leaves its field unset.
func constructUpdate(ctx context.Context, data *{{ .Type }}Model) ({{ .UpdateConstructReturnType }}, error) {
	_ = ctx
	body := {{ .UpdateWriteConstructor }}
{{ .UpdateConstructBody }}
	return body, nil
}
{{ end }}