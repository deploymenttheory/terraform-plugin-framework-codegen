{{ .Header }}

// The upgraders below are the generated default: each prior schema version is
// refused by name. A version bump says state written by an earlier provider
// needs translating, and what the old fields *meant* is not in any
// specification -- so until the mapping is declared in the blueprint and
// generated, refusing loudly beats guessing with state practitioners cannot
// recover. An edit made here directly is drift the check reports. Removing
// hooks.stateUpgrade means setting schema.version back to 0, because the
// generated resource asserts resource.ResourceWithUpgradeState while the flag
// is set.

package {{ .Package }}

import (
	"context"

	"github.com/hashicorp/terraform-plugin-framework/resource"
)

// UpgradeState migrates state written by an earlier schema version.
//
// The current version is {{ .SchemaVersion }}, so there is one entry per version a practitioner
// might still be holding. Every one is scaffolded, because a missing key blocks them outright.
//
// Each is deliberately left failing rather than passing state through. A passthrough would look
// like it worked and quietly reinterpret every old field under the new schema, which is the
// failure this file exists to prevent; an error tells the practitioner to stay on the older
// provider until the migration is written, which is recoverable.
func (r *{{ .GoTypeName }}) UpgradeState(ctx context.Context) map[int64]resource.StateUpgrader {
	return map[int64]resource.StateUpgrader{
{{- range .PriorVersions }}
		{{ . }}: {
			StateUpgrader: func(
				ctx context.Context,
				req resource.UpgradeStateRequest,
				resp *resource.UpgradeStateResponse,
			) {
				resp.Diagnostics.AddError(
					"State Upgrade Not Implemented",
					"{{ $.ResourceName }} declares schema version {{ $.SchemaVersion }}, but the "+
						"upgrade from version {{ . }} has not been written yet. Implement it in "+
						"state_upgrade.go, or pin the previous provider version until it is.",
				)
			},
		},
{{- end }}
	}
}
