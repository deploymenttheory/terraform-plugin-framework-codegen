// This file is yours.
//
// It was scaffolded once, carries no generated marker, and `emit` will not write over it again.
// Deleting it means setting schema.version back to 0 and removing hooks.stateUpgrade, because the
// generated resource asserts resource.ResourceWithUpgradeState when that flag is set.
//
// # Why this is not generated
//
// The generator knows the schema changed. It cannot know what the old fields meant.
//
// A version bump says "state written by an earlier version of this provider needs translating".
// Whether a renamed attribute is the same value under a new name, whether a string that became a
// list should be wrapped or split, whether a removed field's value belongs anywhere at all -- none
// of that is in a specification, and getting it wrong corrupts real state that practitioners
// cannot recover from without editing state files by hand.
//
// # What the framework does with this
//
// fwserver calls UpgradeState only when the version stored in state differs from the schema's.
// When they match, state is passed through untouched and this method is never reached. So the map
// below is keyed by the version being upgraded *from*, and every version a practitioner might
// still be holding needs an entry -- a missing one produces "Terraform was expecting an
// implementation for version N upgrade" and blocks them entirely.

package {{ .Package }}

import (
	"context"

	"github.com/hashicorp/terraform-plugin-framework/resource"
)

// UpgradeState migrates state written by an earlier schema version.
//
// The current version is {{ .SchemaVersion }}, so there is one entry per version a practitioner
// might still be holding. Every one is scaffolded, because a missing key blocks them outright.
//
// Each is deliberately left failing rather than passing state through. A passthrough would look
// like it worked and quietly reinterpret every old field under the new schema, which is the
// failure this file exists to prevent; an error tells the practitioner to stay on the older
// provider until the migration is written, which is recoverable.
func (r *{{ .GoTypeName }}) UpgradeState(ctx context.Context) map[int64]resource.StateUpgrader {
	return map[int64]resource.StateUpgrader{
{{- range .PriorVersions }}
		{{ . }}: {
			StateUpgrader: func(
				ctx context.Context,
				req resource.UpgradeStateRequest,
				resp *resource.UpgradeStateResponse,
			) {
				resp.Diagnostics.AddError(
					"State Upgrade Not Implemented",
					"{{ $.ResourceName }} declares schema version {{ $.SchemaVersion }}, but the "+
						"upgrade from version {{ . }} has not been written yet. Implement it in "+
						"state_upgrade.go, or pin the previous provider version until it is.",
				)
			},
		},
{{- end }}
	}
}
