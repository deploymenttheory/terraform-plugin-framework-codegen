{{ .Header }}

# The seed resource, the ephemeral that opens it, and the echo that makes the opened
# value observable. One file, because each reference only resolves against the block
# above it. The echo provider is HashiCorp's test fixture for exactly this: an ephemeral
# value never reaches state, so a test needs somewhere else to read it from.

{{ range .Seed.DataBlocks }}{{ . }}

{{ end }}resource "{{ .Seed.TerraformType }}" "{{ .Seed.Label }}" {
{{- range .Seed.Values }}
  {{ .Name }}{{ .Padding }} = {{ .HCL }}
{{- end }}
}

ephemeral "{{ .TerraformType }}" "{{ .Label }}" {
{{- range .Args }}
  {{ .Name }}{{ .Padding }} = {{ .HCL }}
{{- end }}
}

provider "echo" {
  data = ephemeral.{{ .TerraformType }}.{{ .Label }}
}

resource "echo" "{{ .Label }}" {}
