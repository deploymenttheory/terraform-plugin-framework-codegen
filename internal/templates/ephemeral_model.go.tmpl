{{ .Header }}
{{ if .DocRefComment }}
{{ .DocRefComment }}
{{- end }}
package {{ .Package }}

import (
{{- if .NestedModels }}
	"github.com/hashicorp/terraform-plugin-framework/attr"
{{- end }}
	"github.com/hashicorp/terraform-plugin-framework/types"
)

// {{ .ModelTypeName }} carries a {{ .EphemeralName }}'s configuration in and its result
// out. There is no timeouts field: an ephemeral schema has no timeouts block, and the
// open deadline is the generated constant.
type {{ .ModelTypeName }} struct {
{{- range .ModelFields }}
	{{ . }}
{{- end }}
}
{{ range .NestedModels }}
// {{ .GoTypeName }} is one element of a nested attribute.
type {{ .GoTypeName }} struct {
{{- range .Fields }}
	{{ . }}
{{- end }}
}

var {{ .AttrTypesVar }} = map[string]attr.Type{
{{- range .AttrTypeEntries }}
	{{ . }}
{{- end }}
}

var {{ .ObjectTypeVar }} = types.ObjectType{AttrTypes: {{ .AttrTypesVar }}}
{{ end }}
