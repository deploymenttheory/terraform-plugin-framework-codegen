{{ .Header }}

package {{ .Package }}

import (
{{ .Imports.Resource }}
)

const (
	// TypeName is the Terraform type this resource registers as.
	TypeName = "{{ .ResourceName }}"

	// Default per-operation timeouts, in seconds. A practitioner overrides them
	// with the resource's timeouts block.
	CreateTimeout = {{ .Timeouts.Create }}
	ReadTimeout   = {{ .Timeouts.Read }}
	UpdateTimeout = {{ .Timeouts.Update }}
	DeleteTimeout = {{ .Timeouts.Delete }}
)

{{ if .PatternVars }}
// Patterns the schema's RegexMatches validators check against.
//
// Compiled once at package scope rather than inline in the schema, so the expression sits
// somewhere a reader can find it instead of buried mid-literal.
{{- range .PatternVars }}
{{ . }}
{{- end }}
{{ end }}
// Compile-time assertions that this resource implements what it claims to. They
// turn a missing method into a build failure rather than a runtime surprise.
var (
{{- range .Interfaces }}
	{{ . }}
{{- end }}
)

// {{ .ConstructorFn }} returns the {{ .ResourceName }} resource.
func {{ .ConstructorFn }}() resource.Resource {
	return &{{ .GoTypeName }}{}
}

// {{ .GoTypeName }} implements the {{ .ResourceName }} resource.
type {{ .GoTypeName }} struct {
	client {{ .SDKClientType }}
}

// Metadata returns the resource type name.
func (r *{{ .GoTypeName }}) Metadata(_ context.Context, _ resource.MetadataRequest, resp *resource.MetadataResponse) {
	resp.TypeName = TypeName
}

// Configure receives the configured SDK client from the provider.
func (r *{{ .GoTypeName }}) Configure(ctx context.Context, req resource.ConfigureRequest, resp *resource.ConfigureResponse) {
	r.client = client.ForResource(ctx, req, resp, TypeName)
}
{{ if .ImportState }}
// ImportState maps a terraform import into state.
func (r *{{ .GoTypeName }}) ImportState(ctx context.Context, req resource.ImportStateRequest, resp *resource.ImportStateResponse) {
	{{ .ImportState }}
}
{{ end }}
{{ with .Identity }}
// IdentitySchema returns the resource identity schema.
//
// Terraform addresses an object by its identity independently of configuration, which is
// what makes import by identity and list resources possible. Declaring it is what makes
// this resource satisfy resource.ResourceWithIdentity.
func (r *{{ $.GoTypeName }}) IdentitySchema(_ context.Context, _ resource.IdentitySchemaRequest, resp *resource.IdentitySchemaResponse) {
	resp.IdentitySchema = identityschema.Schema{
		Attributes: map[string]identityschema.Attribute{
{{- range .Attributes }}
			{{ . }},
{{- end }}
		},
	}
}
{{ end }}
{{ if .ConfigValidators }}
// ConfigValidators returns the cross-attribute rules for this resource.
//
// On the resource rather than on an attribute because that is what they are about: a rule
// relating two fields has no single field to hang off, and the diagnostic should name the block.
func (r *{{ .GoTypeName }}) ConfigValidators(_ context.Context) []resource.ConfigValidator {
	return []resource.ConfigValidator{
{{- range .ConfigValidators }}
		{{ . }},
{{- end }}
	}
}
{{ end }}
// Schema returns the resource schema.
func (r *{{ .GoTypeName }}) Schema(ctx context.Context, _ resource.SchemaRequest, resp *resource.SchemaResponse) {
	resp.Schema = schema.Schema{
{{- if .SchemaVersion }}
		// Past zero, so Terraform will ask UpgradeState to migrate any state written by an
		// earlier version. See state_upgrade.go.
		Version: {{ .SchemaVersion }},
{{- end }}
{{- if .MarkdownDescription }}
		MarkdownDescription: {{ printf "%q" .MarkdownDescription }},
{{- end }}
		Attributes: map[string]schema.Attribute{
{{- range .SchemaAttributes }}
			{{ . }},
{{- end }}
		},
		Blocks: map[string]schema.Block{
			"timeouts": commonschema.ResourceTimeouts(ctx),
		},
	}
}
