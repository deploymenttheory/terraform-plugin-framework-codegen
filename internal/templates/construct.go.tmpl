	var elements []{{ .ModelType }}
	diags.Append(v.ElementsAs(ctx, &elements, false)...)
	if diags.HasError() {
		return nil, diags
	}

	out := make([]{{ .SDKType }}, 0, len(elements))
	for _, m := range elements {
{{- if .ConstructorExpr }}
