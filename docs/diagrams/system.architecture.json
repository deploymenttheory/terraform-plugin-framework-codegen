  "cards": [
    {
      "dot": "cyan",
      "title": "Three things a human writes",
      "items": [
        "tfpfgen.yaml \u2014 the provider's configuration",
        "spec/corrections/** \u2014 accepted corrections, each with a justification",
        "audit/inputs.json \u2014 values the audit cannot synthesise"
      ]
    },
    {
      "dot": "amber",
      "title": "Everything else is derived",
      "items": [
        "A provider repo holds no authored Go at all",
        "Every generated file carries a DO-NOT-EDIT header and a manifest entry",
        "verify regenerates and byte-compares, so a hand edit fails the build"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why the audit exists",
      "items": [
        "An OpenAPI document says what an API's fields are called",
        "It does not say which may be sent together, which the server overwrites, or which a create refuses",
        "Only the live API says that, and only by being asked"
      ]
    }
  ]
