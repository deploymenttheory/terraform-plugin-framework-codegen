    {
      "dot": "amber",
      "title": "The refusal is read, not guessed",
      "items": [
        "The fake API and the executor share one sentence form, so a parser can pull the field name out with one expression",
        "A refusal that fits no clause stops the entity rather than inventing a fix"
      ]
    },
    {
      "dot": "cyan",
      "title": "Four corrections, and no more",
      "items": [
        "add a field the API named",
        "remove one it rejected",
        "add a field another requires",
        "borrow a real id for a reference"
      ]
    },
    {
      "dot": "emerald",
      "title": "When the grammar cannot read it",
      "items": [
        "A free-form refusal that still names a declared field is retried across that field's other enum values",
        "Which combinations were accepted and refused is itself the evidence a conditional rule is inferred from"
      ]
    }
  ]
