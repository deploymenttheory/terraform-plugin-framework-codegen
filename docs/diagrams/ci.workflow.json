      "dot": "amber",
      "title": "The gate is the point",
      "items": [
        "Generation refuses to write a revised spec while a correction awaits a decision",
        "The continuation waits for every decision, not for an empty queue"
      ]
    },
    {
      "dot": "rose",
      "title": "One decision, one group",
      "items": [
        "A pull request answers every finding of one kind on one entity",
        "Closing rejects the group and writes a marker that suppresses re-proposal"
      ]
    },
    {
      "dot": "emerald",
      "title": "Nothing ships unverified",
